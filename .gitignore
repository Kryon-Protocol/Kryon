# Build artifacts
client/.next/
client/out/
client/dist/
kryon-protocol/target/

# Dependencies
node_modules/
client/node_modules/
kryon-protocol/node_modules/

# TypeScript cache
*.tsbuildinfo

# Environment files
.env
.env.local
.env.*.local
# Per-network env files. `.env.mainnet` was tracked and held only public
# NEXT_PUBLIC_* config, but a tracked file with that name is where a secret
# eventually gets pasted, and git remembers. The committed copy is now
# `.env.mainnet.example`; real ones stay local (KRY-S4).
.env.mainnet
.env.testnet
.env.production

# Deploy secrets (private keys — never commit)
kryon-protocol/infra/deploy/*secrets*.env
kryon-protocol/infra/deploy/__pycache__/
# Generated by scripts/add-market.ts. The proposals file carries an `eta` that
# expires, and the markets file is a per-machine checkpoint ledger — both are
# regenerable and neither should be committed.
kryon-protocol/infra/deploy/*-market-proposals.json
kryon-protocol/infra/deploy/*-markets.json

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Misc
.cache/

# Claude Code local state
.claude/

# Marketing / pitch collateral — not part of the shipped product
DEMO-DAY-PITCH.md
LAUNCH-VIDEO-60S.md

# Local scratch dumps from ad-hoc API pokes
activity.json
current_activity.json

# Audit reports (local reference only, not published)
Audit Reports/
AUDIT_REPORT.md
FINAL_AUDIT_REPORT.md
MainnetImpAudit.md

# Build artifact shipped to the web box, never source
*.tar.gz
